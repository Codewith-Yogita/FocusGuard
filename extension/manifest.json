{
  "manifest_version": 3,
  "name": "FocusGuard - Tab Distraction Shield",
  "version": "1.0.0",
  "description": "In-page DOM warning HUD, video pause, and tab-level distraction blocker for FocusGuard.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGuard Controller"
  }
}
